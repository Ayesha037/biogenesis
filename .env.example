# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional but recommended (raises PubMed rate limit from 3 -> 10 req/sec)
# Get one free: https://www.ncbi.nlm.nih.gov/account/  -> Settings -> API Key Management
NCBI_API_KEY=

# Your email is required by NCBI E-utilities usage policy (not used for anything else)
NCBI_EMAIL=your_email@example.com

# Which Groq-hosted model to use for the agents (free tier)
GROQ_MODEL=llama-3.3-70b-versatile
